{
  "name": "naf/cli",
  "description": "NAF CLI Plugin for console applications.",
  "minimum-stability": "stable",
  "license": "MIT",
  "type": "naf-plugin",
  "authors": [
    {
      "name": "Flo Knapp",
      "email": "office@florianknapp.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Naf\\CLI\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-readline": "*",
    "naf/framework": "^0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.1",
    "phpunit/php-code-coverage": "^12.1"
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "bin": [
    "bin/naf"
  ]
}
